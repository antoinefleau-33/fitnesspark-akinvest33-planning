[Unit]
Description=FreePlay OS — installation des applications au premier démarrage
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/freeplay-os/setup/install.sh --firstboot
TimeoutStartSec=0
StandardOutput=append:/var/log/freeplay-install.log
StandardError=append:/var/log/freeplay-install.log

[Install]
WantedBy=multi-user.target
