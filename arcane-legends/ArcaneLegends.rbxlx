----------------------------------------------------------------
Config.GamePasses = {
	DoubleMana  = { Id = 0, Name = "x2 Mana",            Desc = "Double toute la mana canalisée." },        -- TODO_UTILISATEUR : ID du gamepass
	DoubleGems  = { Id = 0, Name = "x2 Gemmes",          Desc = "Double toutes les gemmes gagnées." },      -- TODO_UTILISATEUR : ID du gamepass
