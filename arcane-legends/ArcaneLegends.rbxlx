	OrderedStoreName = "ArcaneLegends_ManaTotale_v1",
	AutosaveInterval = 120, -- secondes
	MaxRetries = 3,
	RetryBaseDelay = 2,     -- backoff exponentiel : 2 s, 4 s, 8 s
}

----------------------------------------------------------------
-- CLASSEMENT
----------------------------------------------------------------
Config.Leaderboard = {
