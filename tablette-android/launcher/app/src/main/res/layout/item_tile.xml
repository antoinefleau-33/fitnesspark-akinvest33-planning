<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/tile_margin"
    android:background="@drawable/tile_focus"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false">

    <RelativeLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tile_height"
        android:padding="16dp">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/tile_icon"
            android:layout_height="@dimen/tile_icon"
            android:layout_alignParentTop="true"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_badge"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="@string/badge_install"
            android:textColor="@color/text_bright"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_translucent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/subtitle"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_bright"
            android:textSize="20sp"
            android:textStyle="bold" />

    </RelativeLayout>

</FrameLayout>
